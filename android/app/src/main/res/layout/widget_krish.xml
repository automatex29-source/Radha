<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: tap the bar to ask Krish, tap the mic to talk. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="48dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/appName"
        android:src="@drawable/widget_logo" />

    <TextView
        android:id="@+id/widget_ask"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="@string/widgetHint"
        android:textColor="@color/widgetText"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_mic_background"
        android:contentDescription="@string/widgetMic"
        android:padding="9dp"
        android:src="@drawable/ic_mic" />
</LinearLayout>
