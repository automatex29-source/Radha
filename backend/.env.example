MONGO_URL=mongodb://localhost:27017
DB_NAME=radha
# Optional: login signing secret. If unset, RADHA generates one and keeps it in the database.
# AUTH_SECRET=change-me-to-a-long-random-string
# Emergent Universal Key — only used when running on Emergent. Elsewhere use the provider keys below.
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
CORS_ORIGINS=*

# --- Agent mode (tool use) and image understanding, via LiteLLM.
# Set the key for each provider whose models should support agent mode / images:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Free, no card: https://cloud.cerebras.ai. The App Builder uses it automatically (about 4x more room than Groq).
CEREBRAS_API_KEY=
# Free: https://openrouter.ai/keys. Adds Krish Coder, a model made for code; coding questions go to it.
# CODER_MODEL picks another OpenRouter model (default openrouter/qwen/qwen3-coder:free).
OPENROUTER_API_KEY=
# App Builder model for every user, e.g. claude-sonnet-5-5 (needs ANTHROPIC_API_KEY, about Rs 15-40 per build).
# BUILDER_MODEL=
# Paid models (Claude, GPT) in the chat menu are for Pro accounts; set PAID_MODELS=all to open them to everyone.
# PAID_MODELS=
# Or send every agent call through one OpenAI-compatible gateway instead:
# LLM_GATEWAY_URL=
# LLM_GATEWAY_KEY=

# --- Image generation + voice (speech-to-text, text-to-speech) use OPENAI_API_KEY.
# OPENAI_BASE_URL=            # optional OpenAI-compatible endpoint
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=high            # low | medium | high
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts

# --- Web search: DuckDuckGo is used by default; set for more reliable results.
# TAVILY_API_KEY=

# --- Code sandbox limits (run_python tool)
# SANDBOX_CPU_SECONDS=20
# SANDBOX_WALL_SECONDS=30
# SANDBOX_MEMORY_MB=768
# SANDBOX_PYTHON=/usr/bin/python3

# --- Video generation: OpenAI Sora (OPENAI_API_KEY) or Google Veo (GEMINI_API_KEY).
# VIDEO_PROVIDER=openai        # or gemini; defaults to whichever key is set
# VIDEO_QUALITY=high           # high: Sora 2 Pro 1792x1024 / Veo 3 1080p; standard: sora-2 / Veo 3 Fast 720p
# SORA_PRO_MODEL=sora-2-pro
# SORA_MODEL=sora-2
# VEO_MODEL=veo-3.0-generate-001
# VEO_FAST_MODEL=veo-3.0-fast-generate-001
# VIDEO_TIMEOUT_SECONDS=600

# --- Browser tool (real headless Chromium). Needs: playwright install chromium
# BROWSER_TOOL=0               # disable
# BROWSER_EXECUTABLE_PATH=     # use an existing Chromium binary

# --- PDF fonts: extra Unicode fonts (e.g. CJK) as a colon-separated list of .ttf paths
# PDF_FALLBACK_FONTS=

# --- Automations: set to 0 on extra backend replicas if you only want one scheduler
# (running several is safe — runs are claimed atomically — this just saves work).
# AUTOMATIONS_SCHEDULER=1

# ---- Settings > Connectors (each one shows "Soon" until its keys are set) ----
# Public address of the app, used for sign-in return links and the Telegram webhook (else APP_URL).
# PUBLIC_URL=https://krish.example.com
# Google Drive, Calendar and Gmail: the same Google client as sign-in (a "Web application" client), plus its
# secret. Add <PUBLIC_URL>/api/connectors/oauth/callback as an authorised redirect URI and enable the Drive,
# Calendar and Gmail APIs in Google Cloud.
# GOOGLE_CLIENT_SECRET=
# GitHub and Notion sign-in apps (optional: without them users paste a token instead). Callback URL as above.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Telegram: a bot from @BotFather. Krish sets its webhook itself.
# TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API (Meta). Webhook: <PUBLIC_URL>/api/connectors/whatsapp/webhook with WHATSAPP_VERIFY_TOKEN.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_NUMBER=            # the number people message, e.g. 919876543210
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=        # optional: checks Meta's signature on each webhook

# ---- Settings > Plugins ----
# Cricket scores come from CricAPI when set (free key at cricapi.com), else from a web search.
# CRICAPI_KEY=
