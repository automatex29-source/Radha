MONGO_URL=mongodb://localhost:27017
DB_NAME=radha
AUTH_SECRET=change-me-to-a-long-random-string
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
CORS_ORIGINS=*

# --- Agent mode (tool use) and image understanding, via LiteLLM.
# Set the key for each provider whose models should support agent mode / images:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Or send every agent call through one OpenAI-compatible gateway instead:
# LLM_GATEWAY_URL=
# LLM_GATEWAY_KEY=

# --- Image generation + voice (speech-to-text, text-to-speech) use OPENAI_API_KEY.
# OPENAI_BASE_URL=            # optional OpenAI-compatible endpoint
# IMAGE_MODEL=gpt-image-1
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts

# --- Web search: DuckDuckGo is used by default; set for more reliable results.
# TAVILY_API_KEY=

# --- Code sandbox limits (run_python tool)
# SANDBOX_CPU_SECONDS=20
# SANDBOX_WALL_SECONDS=30
# SANDBOX_MEMORY_MB=768
# SANDBOX_PYTHON=/usr/bin/python3

# --- Video generation: OpenAI Sora (OPENAI_API_KEY) or Google Veo (GEMINI_API_KEY).
# VIDEO_PROVIDER=openai        # or gemini; defaults to whichever key is set
# SORA_MODEL=sora-2
# VEO_MODEL=veo-3.0-fast-generate-001
# VIDEO_TIMEOUT_SECONDS=600

# --- Browser tool (real headless Chromium). Needs: playwright install chromium
# BROWSER_TOOL=0               # disable
# BROWSER_EXECUTABLE_PATH=     # use an existing Chromium binary

# --- PDF fonts: extra Unicode fonts (e.g. CJK) as a colon-separated list of .ttf paths
# PDF_FALLBACK_FONTS=
