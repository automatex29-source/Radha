# RADHA settings for Docker.
# Copy this file to ".env" (same folder), paste your keys after the = signs, and save.
# You need at least ONE of the first three keys. Leave the others empty.

# Claude models — chat, agent mode, the app builder and automations.
# Get one at https://console.anthropic.com  (API keys)
ANTHROPIC_API_KEY=

# GPT models, image generation, voice (speech-to-text and read-aloud) and Sora video.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini models and Veo video.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: better web search results (https://tavily.com). DuckDuckGo is used without it.
TAVILY_API_KEY=

# Optional: which model new chats start with (otherwise the first one you have a key for).
# AI_MODEL=claude-sonnet-4-6

# More settings (video quality, sandbox limits, …) are listed in backend/.env.example.
